// DEPLOYED TO SHARED PROJECT farmfresh-5e95e (also hosts online-utilities.com
// and the farmfresh app). This file is a UNION: the farmfresh auth/role rules
// (users, inventory, orders, euAuditLogs, system) are live-managed elsewhere —
// do not remove them, and re-sync if that app changes its rules. The
// games_leaderboards + item_ratings blocks are owned by this repo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole(request.auth.uid) == 'superadmin' ||
        getUserRole(request.auth.uid) == 'super_admin'
      );
    }

    function isFarmSupplier() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'farm_supplier';
    }

    function isCustomer() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'customer';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS
    match /users/{userId} {
      allow read: if isSuperAdmin() || isFarmSupplier() || isOwner(userId);
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if isSuperAdmin() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // INVENTORY
    match /inventory/{batchId} {
      allow read: if true;  // Public read for customers
      allow create: if isFarmSupplier() || isSuperAdmin();
      allow update: if isFarmSupplier() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if isSuperAdmin() || isFarmSupplier() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() && isCustomer();
      allow update: if isSuperAdmin() || isFarmSupplier() || (isAuthenticated() && resource.data.customerId == request.auth.uid && resource.data.status == 'pending');
    }

    // EU COMPLIANCE AUDIT LOGS
    match /euAuditLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isSuperAdmin() || isFarmSupplier();
    }

    // SYSTEM SETTINGS
    match /system/settings {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // === games-hub additions (anonymous, zero-auth) ===

    // Anonymous game leaderboards: public read, create-only write with
    // strict field validation. No auth — playerId is a client-generated UUID.
    match /games_leaderboards/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['gameId', 'playerId', 'nickname', 'score', 'createdAt'])
                    && request.resource.data.gameId is string
                    && request.resource.data.gameId.size() <= 64
                    && request.resource.data.playerId is string
                    && request.resource.data.playerId.size() <= 64
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 24
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 1000000000
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Anonymous per-item ratings: public read, create-only validated writes.
    // One doc per vote; aggregates are computed client-side.
    match /item_ratings/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['itemId', 'playerId', 'stars', 'app', 'createdAt'])
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() <= 64
                    && request.resource.data.playerId is string
                    && request.resource.data.playerId.size() <= 64
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.app is string
                    && request.resource.data.app.size() <= 32
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Anonymous written reviews: public read, create-only validated writes.
    match /item_reviews/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['itemId', 'playerId', 'stars', 'review', 'app', 'createdAt'])
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() <= 64
                    && request.resource.data.playerId is string
                    && request.resource.data.playerId.size() <= 64
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.review is string
                    && request.resource.data.review.size() > 0
                    && request.resource.data.review.size() <= 500
                    && request.resource.data.app is string
                    && request.resource.data.app.size() <= 32
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // Anonymous bug/feature reports: write-only — public create with
    // validated fields, no public read so reports stay private.
    match /feedback_reports/{entryId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(
                        ['type', 'message', 'url', 'userAgent', 'lang', 'app', 'createdAt'])
                    && request.resource.data.type in ['bug', 'feature']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 500
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() <= 500
                    && request.resource.data.lang is string
                    && request.resource.data.lang.size() <= 32
                    && request.resource.data.app is string
                    && request.resource.data.app.size() <= 32
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
