rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous game leaderboards: public read, create-only write with
    // strict field validation. No auth — playerId is a client-generated UUID.
    match /games_leaderboards/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['gameId', 'playerId', 'nickname', 'score', 'createdAt'])
                    && request.resource.data.gameId is string
                    && request.resource.data.gameId.size() <= 64
                    && request.resource.data.playerId is string
                    && request.resource.data.playerId.size() <= 64
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 24
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 1000000000
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
    // Anonymous per-item ratings: public read, create-only validated writes.
    // One doc per vote; aggregates are computed client-side.
    match /item_ratings/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['itemId', 'playerId', 'stars', 'app', 'createdAt'])
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() <= 64
                    && request.resource.data.playerId is string
                    && request.resource.data.playerId.size() <= 64
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.app is string
                    && request.resource.data.app.size() <= 32
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
